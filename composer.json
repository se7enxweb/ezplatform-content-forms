{
    "name": "se7enxweb/ezplatform-content-forms",
    "description": "Use Symfony Forms with Exponential Platform Content & User objects",
    "license": "GPL-2.0-or-later",
    "type": "ezplatform-bundle",
    "require": {
        "php": "^7.3 || ^8.0 || ^8.1 || ^8.2 || ^8.3 || ^8.4 || ^8.5",
        "ext-json": "*",
        "se7enxweb/ezplatform-kernel": "^1.3@dev",
        "symfony/dependency-injection": "^3.4",
        "symfony/http-kernel": "^3.4",
        "symfony/http-foundation": "^3.4",
        "symfony/options-resolver": "^3.4",
        "symfony/config": "^3.4",
        "symfony/yaml": "^3.4",
        "symfony/filesystem": "^3.4",
        "symfony/form": "^3.4",
        "symfony/event-dispatcher": "^3.4",
        "symfony/validator": "^3.4",
        "symfony/routing": "^3.4",
        "symfony/translation": " ^3.4",
        "jms/translation-bundle": "^1.5"
    },
    "require-dev": {
        "ibexa/ci-scripts": "^0.1@dev",
        "se7enxweb/doctrine-dbal-schema": "^1.0@dev",
        "se7enxweb/behatbundle": "^8.3@dev",
        "se7enxweb/ezplatform-http-cache": "^2.3@dev",
        "se7enxweb/ezplatform-rest": "^1.3@dev",
        "phpunit/phpunit": "^8.2",
        "matthiasnoback/symfony-dependency-injection-test": "^4.0",
        "behat/behat": "^3.5",
        "friendsofphp/php-cs-fixer": "^2.16.0",
        "se7enxweb/ezplatform-code-style": "^0.1.0"
    },
    "autoload": {
        "psr-4": {
            "EzSystems\\EzPlatformContentFormsBundle\\": "src/bundle/",
            "EzSystems\\EzPlatformContentForms\\": "src/lib/",
            "EzSystems\\EzPlatformContentForms\\Features\\": "features/",
            "Ibexa\\ContentForms\\": "src/lib/",
            "Ibexa\\Bundle\\ContentForms\\": "src/bundle/",
            "Ibexa\\Contracts\\ContentForms\\": "src/contracts/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EzSystems\\EzPlatformContentForms\\Tests\\": "src/lib/Tests",
            "EzSystems\\EzPlatformContentFormsBundle\\Tests\\": "src/bundle/Tests",
            "Ibexa\\Tests\\ContentForms\\": "tests/lib/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.3.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "*/*": false
        }
    },
    "scripts": {
        "fix-cs": "php-cs-fixer fix -v --show-progress=estimating",
        "check-cs": "@fix-cs --dry-run",
        "test": "phpunit -c phpunit.xml.dist"
    }
}
